<Window x:Class="SlaveSplit.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:SlaveSplit.ViewModels" xmlns:views="clr-namespace:SlaveSplit.Views" Title="SlaveSplit — Personal Work Agent" Icon="Resources/Icons/SlaveSplit.ico" Width="1280" Height="800" MinWidth="1000" MinHeight="650" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <DataTemplate DataType="{x:Type vm:TaskBoardViewModel}"><views:TaskBoardView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ChatViewModel}"><views:ChatView/></DataTemplate><DataTemplate DataType="{x:Type vm:TodayViewModel}"><views:TodayView/></DataTemplate><DataTemplate DataType="{x:Type vm:TasksViewModel}"><views:TasksView/></DataTemplate><DataTemplate DataType="{x:Type vm:HistoryViewModel}"><views:HistoryView/></DataTemplate><DataTemplate DataType="{x:Type vm:WeeklyReportViewModel}"><views:WeeklyReportView/></DataTemplate><DataTemplate DataType="{x:Type vm:GitHubViewModel}"><views:GitHubView/></DataTemplate><DataTemplate DataType="{x:Type vm:GitHubIssueDetailViewModel}"><views:GitHubIssueDetailView/></DataTemplate><DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView/></DataTemplate><DataTemplate DataType="{x:Type vm:TaskDetailViewModel}"><views:TaskDetailView/></DataTemplate><DataTemplate DataType="{x:Type vm:DailySummaryViewModel}"><views:DailySummaryView/></DataTemplate><DataTemplate DataType="{x:Type vm:LocalLlmPocViewModel}"><views:LocalLlmPocView/></DataTemplate><DataTemplate DataType="{x:Type vm:AgentTestRunnerViewModel}"><views:AgentTestRunnerView/></DataTemplate>
  </Window.Resources>
  <Window.InputBindings><KeyBinding Key="N" Modifiers="Control" Command="{Binding QuickAddCommand}"/><KeyBinding Key="L" Modifiers="Control" Command="{Binding FocusChatCommand}"/><KeyBinding Key="Escape" Command="{Binding BackCommand}"/></Window.InputBindings>
  <Grid><Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{StaticResource BackgroundPrimary}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="28,0">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="SlaveSplit" Style="{StaticResource WindowTitle}"/><TextBlock Text="Personal Work Agent" Style="{StaticResource SmallText}" Margin="0,3,0,0"/></StackPanel><ComboBox Grid.Column="1" ItemsSource="{Binding Workspaces}" SelectedItem="{Binding SelectedWorkspace}" DisplayMemberPath="DisplayName" Width="156" Height="32" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="0,0,12,0"/><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Settings.AdminMode}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><Border Background="#13251F" CornerRadius="14" Padding="12,6"><TextBlock Text="● Local Agent" Foreground="{StaticResource Success}" FontSize="12" FontWeight="SemiBold"/></Border><Border Background="{StaticResource BackgroundSecondary}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="14" Padding="12,6" Margin="8,0,0,0"><TextBlock Text="{Binding GitHubHeaderText}" FontSize="12" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextSecondary}"/><Style.Triggers><DataTrigger Binding="{Binding IsGitHubConnected}" Value="True"><Setter Property="Foreground" Value="{StaticResource Success}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border></StackPanel></Grid>
    </Border>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="{StaticResource BackgroundSecondary}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,12,0,0">
          <RadioButton Content="" ToolTip="대화" Style="{StaticResource ChatNavigationButton}" IsChecked="True" Command="{Binding NavigateCommand}" CommandParameter="Chat"/>
          <RadioButton Content="" Tag="▦" ToolTip="업무 보드" Style="{StaticResource NavigationButton}" Command="{Binding NavigateCommand}" CommandParameter="Board"/>
          <RadioButton Content="" Tag="◷" ToolTip="기록" Style="{StaticResource NavigationButton}" Command="{Binding NavigateCommand}" CommandParameter="History"/>
          <RadioButton Content="" Tag="◆" ToolTip="GitHub Issues" Command="{Binding NavigateCommand}" CommandParameter="GitHub"><RadioButton.Style><Style TargetType="RadioButton" BasedOn="{StaticResource NavigationButton}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Settings.AdminMode}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></RadioButton.Style></RadioButton>
          <RadioButton Content="" Tag="AI" ToolTip="Local LLM PoC" Command="{Binding NavigateCommand}" CommandParameter="LocalLlm"><RadioButton.Style><Style TargetType="RadioButton" BasedOn="{StaticResource NavigationButton}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Settings.AdminMode}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></RadioButton.Style></RadioButton>
          <RadioButton Content="" Tag="✓" ToolTip="Agent Test Runner" Command="{Binding NavigateCommand}" CommandParameter="AgentTests"><RadioButton.Style><Style TargetType="RadioButton" BasedOn="{StaticResource NavigationButton}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Settings.AdminMode}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></RadioButton.Style></RadioButton>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,0,0,12"><RadioButton Content="" Tag="⚙" ToolTip="설정" Style="{StaticResource NavigationButton}" Command="{Binding NavigateCommand}" CommandParameter="Settings"/></StackPanel>
      </Grid></Border>
      <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    </Grid>
  </Grid>
</Window>
