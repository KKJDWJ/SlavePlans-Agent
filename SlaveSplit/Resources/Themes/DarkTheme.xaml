<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <sys:Double x:Key="ApplicationContentMaxWidth">1120</sys:Double>
  <Thickness x:Key="ApplicationPageMargin">32,24,32,40</Thickness>
  <Thickness x:Key="ApplicationHeaderMargin">0,0,0,16</Thickness>
  <Thickness x:Key="ApplicationToolbarMargin">32,0,32,16</Thickness>
  <Thickness x:Key="ApplicationContentMargin">0</Thickness>
  <Color x:Key="BackgroundPrimaryColor">#0B0E14</Color><Color x:Key="BackgroundSecondaryColor">#111620</Color><Color x:Key="BackgroundCardColor">#181E2A</Color>
