  <SolidColorBrush x:Key="CalendarHeaderBackground" Color="#111722"/>
  <SolidColorBrush x:Key="CalendarText" Color="#F4F6FA"/>
  <SolidColorBrush x:Key="CalendarMutedText" Color="#798499"/>
  <SolidColorBrush x:Key="CalendarDisabledText" Color="#4D5668"/>
  <SolidColorBrush x:Key="CalendarHoverBackground" Color="#252D3D"/>
  <SolidColorBrush x:Key="CalendarSelectedBackground" Color="#5D50C7"/>
  <SolidColorBrush x:Key="CalendarTodayBorder" Color="#8D7FF7"/>
  <SolidColorBrush x:Key="CalendarBorder" Color="#303849"/>
