<UserControl x:Class="SlaveSplit.Views.TodayView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource BackgroundPrimary}">
  <UserControl.Resources>
    <Style x:Key="DashboardInput" TargetType="TextBox"><Setter Property="Background" Value="{StaticResource BackgroundSecondary}"/><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="Padding" Value="12,8"/></Style>
    <DataTemplate x:Key="CompactTask"><Border Style="{StaticResource CardStyle}" Margin="0,0,0,9" Padding="15,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding DueLabel}" Style="{StaticResource SmallText}" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Open" Style="{StaticResource SecondaryButton}" Padding="8,5" Command="{Binding DataContext.OpenTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/><Button Content="Start" Style="{StaticResource PrimaryButton}" Padding="8,5" Margin="6,0,0,0" Command="{Binding DataContext.StartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/></StackPanel></Grid></Border></DataTemplate>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid MaxWidth="{StaticResource ApplicationContentMaxWidth}" Margin="{StaticResource ApplicationPageMargin}" HorizontalAlignment="Stretch"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Greeting}" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="{Binding DateTitle}" Style="{StaticResource SecondaryText}" Margin="0,6,0,0"/><TextBlock Text="Here's what needs your attention today." Style="{StaticResource SecondaryText}" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Daily Summary" Style="{StaticResource SecondaryButton}" Command="{Binding DailySummaryCommand}" Margin="0,0,8,0"/><Button Content="+ Add task" Style="{StaticResource PrimaryButton}" Command="{Binding ToggleAddCommand}"/></StackPanel></Grid>
    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,22,0,18"><UniformGrid Columns="4"><StackPanel><TextBlock Text="{Binding TodoCount}" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="TODO" Style="{StaticResource SmallText}"/></StackPanel><StackPanel><TextBlock Text="{Binding ProgressCount}" FontSize="27" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/><TextBlock Text="IN PROGRESS" Style="{StaticResource SmallText}"/></StackPanel><StackPanel><TextBlock Text="{Binding BlockedCount}" FontSize="27" FontWeight="SemiBold" Foreground="{StaticResource Warning}"/><TextBlock Text="BLOCKED" Style="{StaticResource SmallText}"/></StackPanel><StackPanel><TextBlock Text="{Binding DoneCount}" FontSize="27" FontWeight="SemiBold" Foreground="{StaticResource Success}"/><TextBlock Text="DONE TODAY" Style="{StaticResource SmallText}"/></StackPanel></UniformGrid></Border>
    <Border Grid.Row="2" Margin="0,0,0,18"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource CardStyle}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsAddPanelOpen}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="QuickAddBox" Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DashboardInput}" ToolTip="What needs to be done?"><TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding QuickAddCommand}"/></TextBox.InputBindings></TextBox><DatePicker Grid.Column="1" SelectedDate="{Binding NewDueDate}" Margin="8,0"/><Button Grid.Column="2" Content="Add" Style="{StaticResource PrimaryButton}" Command="{Binding QuickAddCommand}"/></Grid></Border>
    <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0">
      <TextBlock Text="NOW" Style="{StaticResource SectionTitle}" Foreground="{StaticResource Accent}" Margin="0,0,0,10"/><ItemsControl ItemsSource="{Binding InProgressTasks}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource CardStyle}" Margin="0,0,0,10" Padding="18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,6,0,0"/><TextBlock Text="IN PROGRESS" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="Bold" Margin="0,9,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom"><Button Content="Open" Style="{StaticResource SecondaryButton}" Command="{Binding DataContext.OpenTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/><Button Content="Block" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Command="{Binding DataContext.BlockCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/><Button Content="Complete" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0" Command="{Binding DataContext.CompleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <TextBlock Text="Nothing in progress. Pick your next task." Margin="0,0,0,12"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ProgressCount}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      <TextBlock Text="NEXT" Style="{StaticResource SectionTitle}" Margin="0,12,0,10"/><ItemsControl ItemsSource="{Binding TodoTasks}" ItemTemplate="{StaticResource CompactTask}"/>
      <TextBlock Text="CARRY OVER" Style="{StaticResource SectionTitle}" Foreground="{StaticResource Warning}" Margin="0,14,0,8"/><ItemsControl ItemsSource="{Binding CarryOverTasks}" ItemTemplate="{StaticResource CompactTask}"/>
      <TextBlock Text="UPCOMING" Style="{StaticResource SectionTitle}" Margin="0,14,0,8"/><ItemsControl ItemsSource="{Binding UpcomingTasks}" ItemTemplate="{StaticResource CompactTask}"/><TextBlock Text="BACKLOG" Style="{StaticResource SectionTitle}" Margin="0,14,0,8"/><ItemsControl ItemsSource="{Binding BacklogTasks}" ItemTemplate="{StaticResource CompactTask}"/>
    </StackPanel><StackPanel Grid.Column="1" Margin="10,0,0,0">
      <TextBlock Text="BLOCKED" Style="{StaticResource SectionTitle}" Foreground="{StaticResource Warning}" Margin="0,0,0,10"/><ItemsControl ItemsSource="{Binding BlockedTasks}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource CardStyle}" Margin="0,0,0,10"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding BlockedReason}" Foreground="{StaticResource Warning}" Margin="0,6,0,0"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"><Button Content="Open" Style="{StaticResource SecondaryButton}" Command="{Binding DataContext.OpenTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/><Button Content="Resume" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0" Command="{Binding DataContext.ResumeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/></StackPanel></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <TextBlock Text="DONE TODAY" Style="{StaticResource SectionTitle}" Foreground="{StaticResource Success}" Margin="0,14,0,8"/><ItemsControl ItemsSource="{Binding DoneTodayTasks}"><ItemsControl.ItemTemplate><DataTemplate><Button Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Command="{Binding DataContext.OpenTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"><Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="✓" Foreground="{StaticResource Success}"/><TextBlock Grid.Column="1" Text="{Binding CompletedAt, StringFormat=HH:mm}" Style="{StaticResource SmallText}"/><TextBlock Grid.Column="2" Text="{Binding Title}" TextWrapping="Wrap"/></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <Border Style="{StaticResource CardStyle}" Margin="0,20,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="YESTERDAY" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding YesterdayCount, StringFormat={}{0} completed}" Margin="0,7,0,0"/></StackPanel><Button Grid.Column="1" Content="View summary →" Style="{StaticResource SecondaryButton}" Command="{Binding YesterdaySummaryCommand}"/></Grid></Border>
    </StackPanel></Grid>
    <TextBlock Grid.Row="4" Text="{Binding EmptyMessage}" HorizontalAlignment="Center" Margin="0,24,0,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasNoActiveWork}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
  </Grid></ScrollViewer>
</UserControl>
