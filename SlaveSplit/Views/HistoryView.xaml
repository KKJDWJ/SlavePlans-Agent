<UserControl x:Class="SlaveSplit.Views.HistoryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource BackgroundPrimary}">
  <Grid Style="{StaticResource MainContentContainer}"><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="{StaticResource ApplicationHeaderMargin}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="기록" Style="{StaticResource PageTitle}"/><TextBlock Text="저장된 대화" Style="{StaticResource SecondaryText}" Margin="0,4,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="메시지는 내 컴퓨터에 저장됩니다" Style="{StaticResource SmallText}" VerticalAlignment="Center"/></Grid>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border BorderBrush="{StaticResource Border}" BorderThickness="1" Background="{StaticResource BackgroundSecondary}" CornerRadius="10" ClipToBounds="True"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RoundedSearchTextBox}"><TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchCommand}"/></TextBox.InputBindings></TextBox><Button Grid.Column="1" Content="검색" Style="{StaticResource SecondaryButton}" Command="{Binding SearchCommand}" MinHeight="34" Margin="7,0,0,0"/></Grid>
        <ListBox Grid.Row="1" ItemsSource="{Binding Conversations}" SelectedItem="{Binding SelectedConversation}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="10,2"/><Setter Property="Padding" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Item" CornerRadius="10" Padding="12" Background="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Item" Property="Background" Value="#171D28"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#211D3B"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding DateText}" Style="{StaticResource SmallText}"/></Grid><TextBlock Text="{Binding LastMessage}" Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/><TextBlock Text="{Binding MetaText}" Style="{StaticResource SmallText}" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
        <StackPanel Grid.Row="2" Margin="18,10,18,18"><Button Content="대화 삭제" Style="{StaticResource SecondaryButton}" Command="{Binding RequestDeleteCommand}" CommandParameter="{Binding SelectedConversation}"/><StackPanel Margin="0,8,0,0"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsDeleteConfirmationVisible}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="이 대화를 삭제할까요? 업무는 삭제되지 않습니다." Style="{StaticResource SmallText}" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Margin="0,7,0,0"><Button Content="취소" Style="{StaticResource SecondaryButton}" Command="{Binding CancelDeleteCommand}" Margin="0,0,7,0"/><Button Content="삭제 확인" Style="{StaticResource PrimaryButton}" Command="{Binding ConfirmDeleteCommand}"/></StackPanel></StackPanel></StackPanel>
      </Grid></Border>
      <Grid Grid.Column="1" Background="{StaticResource BackgroundPrimary}"><ListBox ItemsSource="{Binding Messages}" Background="Transparent" BorderThickness="0" Padding="30,24" ItemTemplate="{StaticResource MessageBubbleTemplate}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Focusable" Value="False"/><Setter Property="Margin" Value="0,0,0,18"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle></ListBox><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedConversation}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="아직 저장된 대화가 없습니다." Style="{StaticResource PageTitle}"/><TextBlock Text="Slave와 대화를 시작하면 업무 기록이 여기에 저장됩니다." Style="{StaticResource SecondaryText}" HorizontalAlignment="Center" Margin="0,8,0,0"/></StackPanel><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Messages.Count}" Value="0"/><Condition Binding="{Binding HasSelectedConversation}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="이 대화에는 메시지가 없습니다." Style="{StaticResource PageTitle}"/><TextBlock Text="왼쪽에서 내용이 있는 대화를 선택해 주세요." Style="{StaticResource SecondaryText}" HorizontalAlignment="Center" Margin="0,8,0,0"/></StackPanel></Grid>
    </Grid>
  </Grid>
</UserControl>
