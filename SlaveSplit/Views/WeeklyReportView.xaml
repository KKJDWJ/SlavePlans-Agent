<UserControl x:Class="SlaveSplit.Views.WeeklyReportView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource BackgroundPrimary}">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid MaxWidth="{StaticResource ApplicationContentMaxWidth}" Margin="{StaticResource ApplicationPageMargin}" HorizontalAlignment="Stretch"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="WEEKLY REPORT" Style="{StaticResource PageTitle}"/><TextBlock Text="{Binding RangeText}" Style="{StaticResource SecondaryText}" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Button Content="← Previous week" Style="{StaticResource SecondaryButton}" Command="{Binding PreviousCommand}"/><Button Content="This week" Style="{StaticResource SecondaryButton}" Command="{Binding ThisWeekCommand}" Margin="7,0"/><Button Content="Next week →" Style="{StaticResource SecondaryButton}" Command="{Binding NextCommand}"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding CopyStatus}" Style="{StaticResource SmallText}" VerticalAlignment="Center" Margin="0,0,9,0"/><ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}" Padding="7" Margin="0,0,7,0"/><Button Content="Copy Report" Style="{StaticResource PrimaryButton}" Command="{Binding CopyCommand}"/></StackPanel></Grid>
    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,20,0,16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><UniformGrid Columns="5"><StackPanel><TextBlock Text="{Binding Summary.CompletedCount}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource Success}"/><TextBlock Text="COMPLETED" Style="{StaticResource SmallText}"/></StackPanel><StackPanel><TextBlock Text="{Binding Summary.InProgressCount}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/><TextBlock Text="IN PROGRESS" Style="{StaticResource SmallText}"/></StackPanel><StackPanel><TextBlock Text="{Binding Summary.BlockedCount}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource Warning}"/><TextBlock Text="BLOCKED" Style="{StaticResource SmallText}"/></StackPanel><StackPanel><TextBlock Text="{Binding Summary.RemainingCount}" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="REMAINING" Style="{StaticResource SmallText}"/></StackPanel><StackPanel><TextBlock Text="{Binding Summary.CreatedCount}" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="CREATED" Style="{StaticResource SmallText}"/></StackPanel></UniformGrid><StackPanel Grid.Row="1" Margin="0,16,0,0"><ProgressBar Value="{Binding Summary.CompletionRate, Mode=OneWay}" Maximum="1" Height="5" Foreground="{StaticResource Success}"/><TextBlock Text="{Binding CompletionText}" Style="{StaticResource SmallText}" Margin="0,6,0,0"/></StackPanel></Grid></Border>
    <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,9,0"><TextBlock Text="COMPLETED BY DAY" Style="{StaticResource SectionTitle}" Margin="0,0,0,9"/><ItemsControl ItemsSource="{Binding DailyGroups}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource CardStyle}" Margin="0,0,0,10"><StackPanel><TextBlock Text="{Binding Header}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" FontSize="11"/><ItemsControl ItemsSource="{Binding Tasks}" Margin="0,9,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="✓" Foreground="{StaticResource Success}"/><TextBlock Grid.Column="1" Text="{Binding Title}" TextWrapping="Wrap"/><TextBlock Grid.Column="2" Text="{Binding CompletedAt, StringFormat=HH:mm}" Style="{StaticResource SmallText}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
      <StackPanel Grid.Column="1" Margin="9,0,0,0"><Border Style="{StaticResource CardStyle}" Margin="0,0,0,10"><StackPanel><TextBlock Text="IN PROGRESS" Style="{StaticResource SectionTitle}" Foreground="{StaticResource Accent}"/><ItemsControl ItemsSource="{Binding Summary.InProgressTasks}" Margin="0,9,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title, StringFormat=→ {0}}" Margin="0,5" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border><Border Style="{StaticResource CardStyle}" Margin="0,0,0,10"><StackPanel><TextBlock Text="BLOCKED" Style="{StaticResource SectionTitle}" Foreground="{StaticResource Warning}"/><ItemsControl ItemsSource="{Binding Summary.BlockedTasks}" Margin="0,9,0,0"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,5"><TextBlock Text="{Binding Title, StringFormat=⚠ {0}}" TextWrapping="Wrap"/><TextBlock Text="{Binding BlockedReason}" Style="{StaticResource SmallText}" Margin="16,3,0,0"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border><Border Style="{StaticResource CardStyle}" Margin="0,0,0,10"><StackPanel><TextBlock Text="CARRY OVER" Style="{StaticResource SectionTitle}"/><ItemsControl ItemsSource="{Binding Summary.CarryOverTasks}" Margin="0,9,0,0"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,5"><TextBlock Text="{Binding Title, StringFormat=→ {0}}"/><TextBlock Text="{Binding CreatedAt, StringFormat=Created MMM d}" Style="{StaticResource SmallText}" Margin="16,3,0,0"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="REPORT TEXT" Style="{StaticResource SectionTitle}"/><TextBox Text="{Binding ReportText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Background="Transparent" Foreground="{StaticResource TextSecondary}" BorderThickness="0" Margin="0,9,0,0" MinHeight="170"/></StackPanel></Border></StackPanel></Grid>
  </Grid></ScrollViewer>
</UserControl>
