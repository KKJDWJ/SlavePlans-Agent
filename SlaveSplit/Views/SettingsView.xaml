<UserControl x:Class="SlaveSplit.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource BackgroundPrimary}">
  <UserControl.Resources><Style x:Key="SettingsInput" TargetType="TextBox"><Setter Property="Background" Value="{StaticResource BackgroundSecondary}"/><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="Padding" Value="11,8"/></Style></UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Style="{StaticResource MainContentContainer}"><TextBlock Text="설정" Style="{StaticResource PageTitle}"/><TextBlock Text="업무 Agent와 연동 기능을 설정합니다." Style="{StaticResource SecondaryText}" Margin="0,6,0,24"/>
    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="관리자 모드" FontWeight="SemiBold"/><TextBlock Text="Local LLM PoC, Agent Test Runner와 개발용 GitHub 메뉴를 표시합니다." Style="{StaticResource SecondaryText}" Margin="0,6,0,0"/></StackPanel><CheckBox Grid.Column="1" Content="사용" IsChecked="{Binding AdminMode}" VerticalAlignment="Center"/></Grid></Border>
    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"><StackPanel><TextBlock Text="AI PROVIDER" Style="{StaticResource SectionTitle}"/><TextBlock Text="Provider" Style="{StaticResource SecondaryText}" Margin="0,16,0,6"/><ComboBox ItemsSource="{Binding ProviderKinds}" SelectedItem="{Binding SelectedProvider}" Background="{StaticResource BackgroundSecondary}" Foreground="{StaticResource TextPrimary}" Padding="9"/><TextBlock Text="Endpoint" Style="{StaticResource SecondaryText}" Margin="0,14,0,6"/><TextBox Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsInput}" ToolTip="Company AI endpoint"/><TextBlock Text="Model" Style="{StaticResource SecondaryText}" Margin="0,14,0,6"/><TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsInput}"/></StackPanel></Border>
    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="CONNECTION" Style="{StaticResource SectionTitle}"/><StackPanel Orientation="Horizontal" Margin="0,14,0,0"><TextBlock Text="Timeout" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/><TextBox Text="{Binding TimeoutSeconds}" Style="{StaticResource SettingsInput}" Width="65" Margin="12,0,7,0"/><TextBlock Text="seconds" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/></StackPanel><TextBlock Text="{Binding ConnectionResult}" Style="{StaticResource SecondaryText}" Margin="0,12,0,0"/></StackPanel><Button Grid.Column="1" Content="Test Connection" Style="{StaticResource PrimaryButton}" Command="{Binding TestConnectionCommand}" VerticalAlignment="Center"/></Grid></Border>
    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"><StackPanel><TextBlock Text="AGENT" Style="{StaticResource SectionTitle}"/><TextBlock Text="Hybrid mode uses structured AI commands and automatically falls back to the local rule agent." Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,14,0,0"/><TextBlock Text="{Binding StatusText, StringFormat=Current status: {0}}" Foreground="{StaticResource Success}" Margin="0,10,0,0"/></StackPanel></Border>
    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"><StackPanel><TextBlock Text="GITHUB WORKSPACES" Style="{StaticResource SectionTitle}"/><ItemsControl ItemsSource="{Binding Workspaces}" Margin="0,10,0,8"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" Style="{StaticResource SecondaryText}" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding WorkspaceDisplayName,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsInput}" ToolTip="Display name"/><TextBox Grid.Column="1" Text="{Binding WorkspaceOwner,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsInput}" ToolTip="Owner" Margin="8,0,0,0"/><TextBox Grid.Column="2" Text="{Binding WorkspaceRepository,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsInput}" ToolTip="Repository" Margin="8,0,0,0"/><Button Grid.Column="3" Content="추가" Style="{StaticResource ToolbarButton}" Command="{Binding AddWorkspaceCommand}" Margin="8,0,0,0"/></Grid><TextBlock Text="Workspace는 Windows Credential Manager의 기본 Credential Profile을 재사용합니다." Style="{StaticResource SmallText}" Margin="0,8,0,0"/></StackPanel></Border>
    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="INTEGRATIONS · GITHUB" Style="{StaticResource SectionTitle}"/><TextBlock Text="Read-only repository connection" Style="{StaticResource SmallText}" Margin="0,5,0,0"/></StackPanel><CheckBox Grid.Column="1" Content="Enabled" IsChecked="{Binding GitHubEnabled}" VerticalAlignment="Center"/></Grid><Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Owner" Style="{StaticResource SmallText}" Margin="0,0,0,5"/><TextBox Text="{Binding GitHubOwner, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsInput}"/></StackPanel><StackPanel Grid.Column="1" Margin="9,0,0,0"><TextBlock Text="Repository" Style="{StaticResource SmallText}" Margin="0,0,0,5"/><TextBox Text="{Binding GitHubRepositoryName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsInput}"/></StackPanel><StackPanel Grid.Column="2" Margin="9,0,0,0"><TextBlock Text="Timeout" Style="{StaticResource SmallText}" Margin="0,0,0,5"/><TextBox Text="{Binding GitHubTimeoutSeconds}" Style="{StaticResource SettingsInput}"/></StackPanel></Grid><TextBlock Text="Personal Access Token" Style="{StaticResource SmallText}" Margin="0,13,0,5"/><PasswordBox x:Name="GitHubTokenBox" PasswordChanged="GitHubTokenBox_OnPasswordChanged" Background="{StaticResource BackgroundSecondary}" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource Border}" Padding="11,8" ToolTip="Token is stored in Windows Credential Manager, never settings.json"/><Grid Margin="0,13,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding GitHubResult}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/><TextBlock Text="Token is never written to application settings or logs." Style="{StaticResource SmallText}" Margin="0,5,0,0"/></StackPanel><Button Grid.Column="1" Content="{Binding GitHubButtonText}" Style="{StaticResource PrimaryButton}" Command="{Binding TestGitHubCommand}" VerticalAlignment="Center"/></Grid><Border Background="{StaticResource BackgroundSecondary}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,14,0,0"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Setter Property="Background" Value="{StaticResource BackgroundSecondary}"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="14"/><Style.Triggers><DataTrigger Binding="{Binding HasGitHubRepository}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding GitHubRepository.FullName}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding GitHubRepository.Description}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,6,0,0"/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><TextBlock Text="{Binding GitHubRepository.VisibilityText}" Style="{StaticResource SmallText}"/><TextBlock Text="{Binding GitHubRepository.DefaultBranch, StringFormat=Default branch · {0}}" Style="{StaticResource SmallText}" Margin="18,0,0,0"/></StackPanel></StackPanel><Button Grid.Column="1" Content="Open GitHub" Style="{StaticResource SecondaryButton}" Command="{Binding OpenGitHubCommand}" VerticalAlignment="Center"/></Grid></Border></StackPanel></Border>
    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="GITHUB PROJECT INTEGRATION" Style="{StaticResource SectionTitle}"/><TextBlock Text="Optional Projects v2 status synchronization." Style="{StaticResource SecondaryText}" Margin="0,6,0,0"/></StackPanel><CheckBox Grid.Column="1" Content="Enable Project Sync" IsChecked="{Binding GitHubProjectSyncEnabled}" VerticalAlignment="Center"/></Grid><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" ToolTip="Project"/><ComboBox Grid.Column="1" ItemsSource="{Binding StatusFields}" SelectedItem="{Binding SelectedStatusField}" ToolTip="Status field" Margin="8,0"/><Button Grid.Column="2" Content="Test Project Connection" Style="{StaticResource SecondaryButton}" Command="{Binding TestProjectCommand}"/></Grid><TextBlock Text="{Binding ProjectResult}" Style="{StaticResource SmallText}" Margin="0,9,0,0"/></StackPanel></Border>
    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="GITHUB ISSUE CREATION" Style="{StaticResource SectionTitle}"/><TextBlock Text="Create a GitHub Issue after a new local task is safely stored." Style="{StaticResource SecondaryText}" Margin="0,7,0,0"/><TextBlock Text="Default is off. GitHub failures never remove the local task." Style="{StaticResource SmallText}" Margin="0,5,0,0"/></StackPanel><CheckBox Grid.Column="1" Content="Create GitHub Issue for new tasks" IsChecked="{Binding GitHubAutoCreateIssues}" VerticalAlignment="Center" Margin="18,0,0,0"/></Grid></Border>
    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"><StackPanel><TextBlock Text="STARTUP PAGE" Style="{StaticResource SectionTitle}"/><TextBlock Text="Choose the first screen shown when SlaveSplit starts." Style="{StaticResource SecondaryText}" Margin="0,12,0,8"/><ComboBox ItemsSource="{Binding StartupPages}" SelectedItem="{Binding StartupPage}" Background="{StaticResource BackgroundSecondary}" Foreground="{StaticResource TextPrimary}" Padding="9"/></StackPanel></Border>
    <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="STORAGE &amp; CREDENTIALS" Style="{StaticResource SectionTitle}"/><TextBlock Text="Data stays in Local AppData. Company credentials are read through ICredentialProvider and are never stored in source code or logs." Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,14,0,0"/><TextBlock Text="Default token source: SLAVESPLIT_AI_TOKEN environment variable" Style="{StaticResource SmallText}" Margin="0,9,0,0"/></StackPanel></Border>
  </StackPanel></ScrollViewer>
</UserControl>
