<UserControl x:Class="SlaveSplit.Views.TaskDetailView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource BackgroundPrimary}">
  <UserControl.Resources><Style x:Key="DetailInput" TargetType="TextBox"><Setter Property="Background" Value="{StaticResource BackgroundSecondary}"/><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="Padding" Value="10,7"/></Style></UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid MaxWidth="{StaticResource ApplicationContentMaxWidth}" Margin="{StaticResource ApplicationPageMargin}" HorizontalAlignment="Stretch"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="← Back" Style="{StaticResource SecondaryButton}" Command="{Binding BackCommand}" HorizontalAlignment="Left"/><Button Grid.Column="1" Content="Edit task" Style="{StaticResource SecondaryButton}" Command="{Binding ToggleEditCommand}"/></Grid>
    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,18,0,18" Padding="24"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Task.Title}" Style="{StaticResource PageTitle}" TextWrapping="Wrap"/><Border Grid.Column="1" Style="{StaticResource StatusBadge}" Margin="16,0,0,0"><TextBlock Text="{Binding StatusText}" Foreground="#B9B1FF" FontWeight="Bold" FontSize="11"/></Border></Grid><TextBlock Text="{Binding Task.Metadata}" Style="{StaticResource SecondaryText}" Margin="0,10,0,0"/><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><TextBlock Text="{Binding Task.Priority, StringFormat=Priority  {0}}" Style="{StaticResource SmallText}"/><TextBlock Text="{Binding DueText}" Style="{StaticResource SmallText}" Margin="22,0,0,0"/><TextBlock Text="{Binding CompletedText}" Style="{StaticResource SmallText}" Margin="22,0,0,0"/></StackPanel><Border Background="#382817" CornerRadius="9" Padding="12,9" Margin="0,14,0,0"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Setter Property="Background" Value="#382817"/><Style.Triggers><DataTrigger Binding="{Binding IsBlocked}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel><TextBlock Text="BLOCKED" Foreground="{StaticResource Warning}" FontWeight="Bold" FontSize="11"/><TextBlock Text="{Binding Task.BlockedReason}" Margin="0,5,0,0"/></StackPanel></Border><TextBlock Text="{Binding Task.Description}" TextWrapping="Wrap" LineHeight="22" Margin="0,18,0,0" Foreground="{StaticResource TextSecondary}"/>
      <Grid Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="Start" Style="{StaticResource SecondaryButton}" Command="{Binding StartCommand}" Margin="0,0,7,0"/><Button Grid.Column="1" Content="Complete" Style="{StaticResource PrimaryButton}" Command="{Binding CompleteCommand}" Margin="0,0,7,0"/><Button Grid.Column="2" Content="Move to Todo" Style="{StaticResource SecondaryButton}" Command="{Binding TodoCommand}"/><TextBox Grid.Column="4" Text="{Binding BlockReason, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DetailInput}" ToolTip="Why is this task blocked?"/><Button Grid.Column="5" Content="Block" Style="{StaticResource SecondaryButton}" Command="{Binding BlockCommand}" Margin="7,0,0,0"/></Grid><Button Content="Resume from blocked" Command="{Binding UnblockCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsBlocked}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></StackPanel></Border>
    <Border Grid.Row="2" Margin="0,0,0,18"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource CardStyle}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel><TextBlock Text="EDIT TASK" Style="{StaticResource SectionTitle}"/><TextBox Text="{Binding Task.Title}" Style="{StaticResource DetailInput}" Margin="0,12,0,0"/><TextBox Text="{Binding Task.Description}" Style="{StaticResource DetailInput}" Margin="0,8,0,0" MinHeight="90" AcceptsReturn="True" TextWrapping="Wrap"/><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox Text="{Binding Task.Category}" Style="{StaticResource DetailInput}"/><ComboBox Grid.Column="1" ItemsSource="{Binding Priorities}" SelectedItem="{Binding Task.Priority}" Margin="8,0" Padding="8"/><DatePicker Grid.Column="2" SelectedDate="{Binding Task.DueDate}"/></Grid><Button Content="Save changes" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" HorizontalAlignment="Right" Margin="0,12,0,0"/></StackPanel></Border>
    <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource CardStyle}" Margin="0,0,14,18"><StackPanel><TextBlock Text="ACTIVITY" Style="{StaticResource SectionTitle}"/><ItemsControl ItemsSource="{Binding Timeline}" Margin="0,4,0,0"><ItemsControl.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding DateText}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource TimelineDateStyle}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ShowDate}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid><Border Style="{StaticResource TimelineLineStyle}"/><Ellipse Style="{StaticResource TimelineDotStyle}"/></Grid><TextBlock Grid.Column="1" Text="{Binding TimeText}" Style="{StaticResource SmallText}" Margin="5,2,0,24"/><StackPanel Grid.Column="2" Margin="0,0,0,24"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><Border Style="{StaticResource TimelineMemoStyle}"><TextBlock Text="{Binding Memo}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}"/></Border></StackPanel></Grid></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="No activity yet." Margin="0,18,0,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasHistory}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding NoteText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DetailInput}" ToolTip="Add note..."/><Button Grid.Column="1" Content="Add note" Style="{StaticResource PrimaryButton}" Command="{Binding AddNoteCommand}" Margin="8,0,0,0"/></Grid></StackPanel></Border>
      <StackPanel Grid.Column="1"><Border Style="{StaticResource CardStyle}" Margin="0,0,0,14"><StackPanel><TextBlock Text="FROM" Style="{StaticResource SectionTitle}"/><Button Content="{Binding ParentTask.Title}" Command="{Binding OpenParentCommand}" Margin="0,12,0,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasParent}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><TextBlock Text="No parent task" Margin="0,10,0,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource SmallText}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasParent}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Border><Border Style="{StaticResource CardStyle}" Margin="0,0,0,14"><StackPanel><TextBlock Text="FOLLOW-UP" Style="{StaticResource SectionTitle}"/><ItemsControl ItemsSource="{Binding FollowUps}" Margin="0,10,0,0"><ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource SecondaryButton}" Command="{Binding DataContext.OpenTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="0,0,0,7"><StackPanel HorizontalAlignment="Left"><TextBlock Text="{Binding Title}" TextWrapping="Wrap"/><TextBlock Text="{Binding StatusText}" Style="{StaticResource SmallText}" Margin="0,4,0,0"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="RELATED CONVERSATION" Style="{StaticResource SectionTitle}"/><ItemsControl ItemsSource="{Binding RelatedMessages}" Margin="0,10,0,0"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,10"><TextBlock Text="{Binding Sender}" FontWeight="SemiBold" FontSize="11"/><TextBlock Text="{Binding Content}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" MaxHeight="55"/><TextBlock Text="{Binding TimeText}" Style="{StaticResource SmallText}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></StackPanel>
    </Grid><Border Grid.Row="4" Margin="0,0,0,18"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource CardStyle}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsGitHubTask}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="SOURCE" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding GitHubSourceText}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel><Button Grid.Column="1" Content="Open GitHub" Style="{StaticResource SecondaryButton}" Command="{Binding OpenGitHubCommand}" VerticalAlignment="Center"/></Grid></Border><TextBlock Grid.Row="5" Text="{Binding ErrorMessage}" Foreground="{StaticResource Error}"/>
    <Border Grid.Row="4" Margin="0,0,0,18"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource CardStyle}"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsGitHubTask}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="GITHUB" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding GitHubMessage}" Style="{StaticResource SmallText}" Margin="0,7,0,0"/></StackPanel><Button Grid.Column="1" Content="Create GitHub Issue" Style="{StaticResource PrimaryButton}" Command="{Binding CreateGitHubIssueCommand}" VerticalAlignment="Center"/></Grid></Border>
    <Border Grid.Row="4" Margin="0,96,0,18"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource CardStyle}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsGitHubTask}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding GitHubSyncText}" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/><TextBlock Text="{Binding GitHubSyncError}" Foreground="{StaticResource Warning}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel><Button Grid.Column="1" Content="Retry Sync" Style="{StaticResource SecondaryButton}" Command="{Binding RetryGitHubSyncCommand}" VerticalAlignment="Center"/></Grid></Border>
    <Border Grid.Row="4" Margin="0,190,0,18"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource CardStyle}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsGitHubTask}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding GitHubProjectSyncText}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Retry All" Style="{StaticResource SecondaryButton}" Command="{Binding RetryAllGitHubCommand}"/></Grid></Border>
  </Grid></ScrollViewer>
</UserControl>
