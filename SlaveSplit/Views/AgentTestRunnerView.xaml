<UserControl x:Class="SlaveSplit.Views.AgentTestRunnerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource BackgroundPrimary}">
 <UserControl.Resources><Style x:Key="AgentGridText" TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Center"/><Setter Property="LineStackingStrategy" Value="BlockLineHeight"/><Setter Property="LineHeight" Value="14"/></Style></UserControl.Resources>
  <Grid Margin="{StaticResource ApplicationPageMargin}" MaxWidth="{StaticResource ApplicationContentMaxWidth}" HorizontalAlignment="Stretch"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="150"/></Grid.RowDefinitions>
  <TextBlock Text="Agent Test Runner" Style="{StaticResource PageTitle}"/>
  <Border Grid.Row="1" Background="#13251F" CornerRadius="8" Padding="12,8" Margin="0,12,0,10"><StackPanel><TextBlock Text="{Binding SafetyBanner}" Foreground="{StaticResource Success}" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Text="{Binding LocalAiPreflight}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,5,0,0" VerticalAlignment="Center"/></StackPanel></Border>
  <Grid Grid.Row="2" Margin="0,0,0,10" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="현재 Task 테스트" Style="{StaticResource ToolbarButton}" Command="{Binding RunCurrentCommand}" Margin="0,0,6,0"/><Button Grid.Column="1" Content="전체 테스트 실행" Style="{StaticResource PrimaryButton}" Command="{Binding RunAllCommand}" Margin="0,0,6,0"/><Button Grid.Column="2" Content="결과 복사" Style="{StaticResource ToolbarButton}" Command="{Binding CopyResultsCommand}"/><StackPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="{Binding Summary}" TextAlignment="Right" Style="{StaticResource SmallText}" VerticalAlignment="Center" MaxWidth="560" TextWrapping="Wrap"/><TextBlock Text="{Binding CopyStatus}" TextAlignment="Right" Foreground="{StaticResource Success}" VerticalAlignment="Center"/></StackPanel></Grid>
  <DataGrid Grid.Row="3" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}" AutoGenerateColumns="False" IsReadOnly="True" Background="{StaticResource BackgroundSecondary}" Foreground="{StaticResource TextPrimary}" RowBackground="{StaticResource BackgroundSecondary}" AlternatingRowBackground="#121722" AlternationCount="2" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource Border}" BorderBrush="{StaticResource Border}"><DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#171D29"/><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="BorderThickness" Value="0,0,1,1"/><Setter Property="Padding" Value="7,3"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="MinHeight" Value="29"/></Style></DataGrid.ColumnHeaderStyle><DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="Regular"/><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="MinHeight" Value="28"/><Setter Property="VerticalContentAlignment" Value="Center"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#302A58"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#22293A"/></Trigger></Style.Triggers></Style></DataGrid.RowStyle><DataGrid.CellStyle><Style TargetType="DataGridCell"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Foreground}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,5"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="TextBlock.TextAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style></DataGrid.CellStyle><DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource AgentGridText}" Header="Status" Binding="{Binding Status}" Width="70"/><DataGridTextColumn ElementStyle="{StaticResource AgentGridText}" Header="Group" Binding="{Binding Group}" Width="130"/><DataGridTextColumn ElementStyle="{StaticResource AgentGridText}" Header="Scenario" Binding="{Binding Scenario}" Width="150"/><DataGridTextColumn ElementStyle="{StaticResource AgentGridText}" Header="Step" Binding="{Binding Step}" Width="45"/><DataGridTextColumn ElementStyle="{StaticResource AgentGridText}" Header="Input" Binding="{Binding Input}" Width="2*"/><DataGridTextColumn ElementStyle="{StaticResource AgentGridText}" Header="Expected" Binding="{Binding Expected}" Width="2*"/><DataGridTextColumn ElementStyle="{StaticResource AgentGridText}" Header="Source" Binding="{Binding Source}" Width="80"/><DataGridTextColumn ElementStyle="{StaticResource AgentGridText}" Header="Latency" Binding="{Binding LatencyMs}" Width="70"/></DataGrid.Columns></DataGrid>
  <Border Grid.Row="4" Style="{StaticResource CardStyle}" Margin="0,10,0,0" Padding="12"><ScrollViewer><TextBlock TextWrapping="Wrap"><Run Text="Failure: "/><Run Text="{Binding SelectedResult.FailureReason}"/><LineBreak/><Run Text="Actual: "/><Run Text="{Binding SelectedResult.Actual}"/><LineBreak/><Run Text="Source: "/><Run Text="{Binding SelectedResult.Source}"/><Run Text=" · LLM Called: "/><Run Text="{Binding SelectedResult.LlmCalled}"/><Run Text=" · LLM Success: "/><Run Text="{Binding SelectedResult.LlmSuccess}"/><Run Text=" · Failure: "/><Run Text="{Binding SelectedResult.LlmFailureKind}"/><LineBreak/><Run Text="Affected: "/><Run Text="{Binding SelectedResult.AffectedTasks}"/><LineBreak/><Run Text="Before: "/><Run Text="{Binding SelectedResult.BeforeState}"/><LineBreak/><Run Text="After: "/><Run Text="{Binding SelectedResult.AfterState}"/><LineBreak/><Run Text="Raw: "/><Run Text="{Binding SelectedResult.LlmRawOutput}"/></TextBlock></ScrollViewer></Border>
 </Grid>
</UserControl>
