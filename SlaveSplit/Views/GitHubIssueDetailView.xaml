<UserControl x:Class="SlaveSplit.Views.GitHubIssueDetailView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource BackgroundPrimary}">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid MaxWidth="{StaticResource ApplicationContentMaxWidth}" Margin="{StaticResource ApplicationPageMargin}" HorizontalAlignment="Stretch"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="← GitHub Issues" Style="{StaticResource SecondaryButton}" Command="{Binding BackCommand}" HorizontalAlignment="Left"/><Button Grid.Column="1" Content="Refresh" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}"/></Grid>
    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,18,0,16" Padding="25"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Issue.NumberText}" Foreground="{StaticResource TextSecondary}" FontSize="15"/><TextBlock Text="{Binding Issue.Title}" Style="{StaticResource PageTitle}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel><Border Grid.Column="1" Style="{StaticResource StatusBadge}" VerticalAlignment="Top"><TextBlock Text="{Binding Issue.StateText}" Foreground="#B9B1FF" FontWeight="Bold" FontSize="10"/></Border></Grid><ItemsControl ItemsSource="{Binding Issue.Labels}" Margin="0,14,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="#25213D" CornerRadius="8" Padding="8,4" Margin="0,0,7,4"><TextBlock Text="{Binding Name}" Foreground="#C5BEFF" FontSize="11"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Border Background="{StaticResource BackgroundSecondary}" CornerRadius="10" Padding="18" Margin="0,20,0,0"><TextBlock Text="{Binding Issue.BodyText}" TextWrapping="Wrap" LineHeight="22" Foreground="{StaticResource TextPrimary}"/></Border><Grid Margin="0,22,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="CREATED" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Issue.CreatedAt, StringFormat=yyyy.MM.dd HH:mm}" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="UPDATED" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Issue.UpdatedAt, StringFormat=yyyy.MM.dd HH:mm}" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="ASSIGNEE" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Issue.AssigneeText}" Margin="0,6,0,0"/></StackPanel></Grid><Grid Margin="0,22,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="GitHub · Read only" Style="{StaticResource SmallText}" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Open GitHub" Style="{StaticResource PrimaryButton}" Command="{Binding OpenGitHubCommand}"/></Grid></StackPanel></Border>
    <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,16"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="SLAVESPLIT TASK" Style="{StaticResource SectionTitle}"/><TextBlock Text="Create a new task or link this issue to an existing local task." Style="{StaticResource SmallText}" Margin="0,5,0,0"/></StackPanel><Button Grid.Column="1" Content="Track in SlaveSplit" Command="{Binding TrackCommand}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Style.Triggers><DataTrigger Binding="{Binding IsTracked}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></Grid><Grid Margin="0,12,0,0"><Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding IsTracked}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding LinkCandidates}" SelectedItem="{Binding SelectedTask}" DisplayMemberPath="Title" ToolTip="Link existing task"/><Button Grid.Column="1" Content="Link Existing Task" Style="{StaticResource SecondaryButton}" Command="{Binding LinkCommand}" Margin="8,0,0,0"/></Grid><Grid Margin="0,10,0,0"><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsTracked}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="✓ Tracked in SlaveSplit" Foreground="{StaticResource Success}" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Open Task" Style="{StaticResource PrimaryButton}" Command="{Binding OpenTaskCommand}"/></Grid><TextBlock Text="{Binding MappingMessage}" Foreground="{StaticResource Accent}" Margin="0,9,0,0"/></StackPanel></Border>
    <TextBlock Grid.Row="3" Text="{Binding ErrorMessage}" Foreground="{StaticResource Warning}" TextWrapping="Wrap"/>
  </Grid></ScrollViewer>
</UserControl>
