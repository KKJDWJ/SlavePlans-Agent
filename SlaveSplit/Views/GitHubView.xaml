<UserControl x:Class="SlaveSplit.Views.GitHubView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:gh="clr-namespace:SlaveSplit.Services.GitHub" Background="{StaticResource BackgroundPrimary}">
  <UserControl.Resources><Style x:Key="GitHubInput" TargetType="TextBox"><Setter Property="Background" Value="{StaticResource BackgroundSecondary}"/><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="Padding" Value="11,8"/></Style></UserControl.Resources>
  <Grid MaxWidth="{StaticResource ApplicationContentMaxWidth}" HorizontalAlignment="Stretch"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="{StaticResource ApplicationHeaderMargin}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="GitHub Issues" Style="{StaticResource PageTitle}"/><StackPanel Orientation="Horizontal" Margin="0,6,0,0"><TextBlock Text="{Binding RepositoryText}" Style="{StaticResource SecondaryText}"/><TextBlock Text=" · Read only" Foreground="{StaticResource Accent}" FontSize="12"/></StackPanel></StackPanel><Button Grid.Column="1" Content="Refresh" Style="{StaticResource PrimaryButton}" Command="{Binding RefreshCommand}"/></Grid>
    <Grid Grid.Row="1" Margin="{StaticResource ApplicationToolbarMargin}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GitHubInput}" ToolTip="Search issues..."/><ComboBox Grid.Column="1" ItemsSource="{Binding Labels}" SelectedItem="{Binding SelectedLabel}" Padding="8" Margin="8,0,0,0"/><ComboBox Grid.Column="2" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}" Padding="8" Margin="8,0,0,0"/></Grid>
    <Grid Grid.Row="2" Margin="{StaticResource ApplicationToolbarMargin}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Button Content="All" Style="{StaticResource SecondaryButton}" Command="{Binding FilterCommand}" CommandParameter="{x:Static gh:GitHubIssueState.All}" Margin="0,0,7,0"/><Button Content="Open" Style="{StaticResource SecondaryButton}" Command="{Binding FilterCommand}" CommandParameter="{x:Static gh:GitHubIssueState.Open}" Margin="0,0,7,0"/><Button Content="Closed" Style="{StaticResource SecondaryButton}" Command="{Binding FilterCommand}" CommandParameter="{x:Static gh:GitHubIssueState.Closed}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock Text="{Binding SyncMessage}" Style="{StaticResource SmallText}" VerticalAlignment="Center" Margin="0,0,8,0"/><Button Content="{Binding SyncButtonText}" Style="{StaticResource SecondaryButton}" Command="{Binding SyncAllCommand}"/></StackPanel></Grid>
    <Grid Grid.Row="3"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="{StaticResource ApplicationContentMargin}"><TextBlock Text="{Binding LoadingText}" Foreground="{StaticResource Accent}" Margin="0,6,0,12"/><ItemsControl ItemsSource="{Binding Issues}"><ItemsControl.ItemTemplate><DataTemplate><Button Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Command="{Binding DataContext.OpenIssueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Cursor="Hand"><Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Card" Style="{StaticResource CardStyle}" Margin="0,0,14,10" Padding="17,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding NumberText}" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold"/><Border Style="{StaticResource StatusBadge}" HorizontalAlignment="Left" Margin="0,8,0,0"><TextBlock Text="{Binding StateText}" Foreground="#B9B1FF" FontSize="9" FontWeight="Bold"/></Border></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/><ItemsControl ItemsSource="{Binding Labels}" Margin="0,8,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="#25213D" CornerRadius="8" Padding="7,3" Margin="0,0,6,3"><TextBlock Text="{Binding Name}" Foreground="#C5BEFF" FontSize="10"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="{Binding AssigneeText, StringFormat=Assignee · {0}}" Style="{StaticResource SmallText}" Margin="0,7,0,0"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding UpdatedText}" Style="{StaticResource SmallText}" Margin="14,0,0,0"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button Content="Load more" Command="{Binding LoadMoreCommand}" HorizontalAlignment="Center" Margin="0,10,0,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasNextPage}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></StackPanel></ScrollViewer>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="430"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsEmpty}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="No issues found." FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="This repository currently has no issues matching the selected filter." TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsEmpty}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource Warning}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"/><Button Content="Open Settings" Style="{StaticResource SecondaryButton}" Command="{Binding OpenSettingsCommand}" HorizontalAlignment="Center" Margin="0,12,0,0"/></StackPanel>
    </Grid>
  </Grid>
</UserControl>
