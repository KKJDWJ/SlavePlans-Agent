<UserControl x:Class="SlaveSplit.Views.TaskBoardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:m="clr-namespace:SlaveSplit.Models" Background="{StaticResource BackgroundPrimary}" Foreground="{StaticResource TextPrimary}">
  <UserControl.Resources>
    <DataTemplate DataType="{x:Type m:WorkTask}">
      <Border Height="92" Background="{StaticResource BackgroundCard}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="7" Padding="11" Margin="0,0,0,8" MouseLeftButtonDown="CardMouseDown" MouseLeftButtonUp="CardMouseUp" MouseMove="CardMouseMove">
        <StackPanel>
          <Border Background="#3A2630" CornerRadius="8" Padding="6,2" HorizontalAlignment="Left"><Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding HasPriorityBadge}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding PriorityText}" FontSize="10" Foreground="{StaticResource Warning}"/></Border>
          <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34" Margin="0,6,0,5"/>
          <TextBlock Text="{Binding DueDateTimeLabel}" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>
  <Grid Style="{StaticResource MainContentContainer}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,16"><TextBlock Text="업무 보드" Style="{StaticResource PageTitle}"/><TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource Error}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
    <ItemsControl Grid.Row="1" ItemsSource="{Binding Columns}" HorizontalContentAlignment="Stretch"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="VerticalAlignment" Value="Stretch"/></Style></ItemsControl.ItemContainerStyle><ItemsControl.ItemTemplate><DataTemplate>
        <Border Margin="0,0,12,0" AllowDrop="True" Tag="{Binding Status}" Drop="ColumnDrop" ClipToBounds="True"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Margin="2,0,0,10"><TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Bold"/><TextBlock Text="{Binding Tasks.Count}" Foreground="{StaticResource TextSecondary}" Margin="7,0,0,0"/></StackPanel>
          <Border Grid.Row="1" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="0,10,0,0"><ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent"><ItemsControl ItemsSource="{Binding Tasks}"/></ScrollViewer></Border>
        </Grid></Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </Grid>
</UserControl>
