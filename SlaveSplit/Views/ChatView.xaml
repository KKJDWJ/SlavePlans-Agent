<UserControl x:Class="SlaveSplit.Views.ChatView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:model="clr-namespace:SlaveSplit.Models" Background="{StaticResource BackgroundPrimary}" PreviewKeyDown="OnPreviewKeyDown">
  <Grid Style="{StaticResource MainContentContainer}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsEmpty}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="무엇을 기록할까요?" Style="{StaticResource PageTitle}" HorizontalAlignment="Center"/><TextBlock Text="오늘 할 일 · 오늘 뭐했지? · 업무 추가" Style="{StaticResource SecondaryText}" Margin="0,8,0,0"/></StackPanel>
    <TextBlock Grid.Row="3" Text="Slave is thinking..." HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,34,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource SmallText}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsProcessing}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding ConversationTitle}" Style="{StaticResource PageTitle}"/><StackPanel Orientation="Horizontal" Margin="0,6,0,0" ToolTip="{Binding ProviderStatusTooltip}"><Ellipse Width="7" Height="7" Margin="0,0,7,0"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{StaticResource Warning}"/><Style.Triggers><DataTrigger Binding="{Binding IsAiConnected}" Value="True"><Setter Property="Fill" Value="{StaticResource Success}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><TextBlock Text="{Binding ProviderStatusText}" Style="{StaticResource SecondaryText}"/><TextBlock Text=" · 업무 도우미" Style="{StaticResource SecondaryText}"/><TextBlock Text=" · " Style="{StaticResource SecondaryText}"/><TextBlock Text="{Binding CopyStatus}" Style="{StaticResource SmallText}"/></StackPanel></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="대화 복사" Style="{StaticResource SecondaryButton}" Command="{Binding CopyChatCommand}" Margin="0,0,8,0"/><Button Content="＋ 새 대화" Style="{StaticResource PrimaryButton}" Command="{Binding NewChatCommand}"/></StackPanel></Grid>
    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,16" Padding="20,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Margin="0,0,28,0"><TextBlock Text="오늘" Style="{StaticResource SectionTitle}"/><TextBlock Text="업무 현황" Style="{StaticResource SmallText}" Margin="0,5,0,0"/></StackPanel>
      <StackPanel Grid.Column="1"><TextBlock Text="{Binding TodoCount}" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="할 일" Style="{StaticResource SmallText}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{Binding ProgressCount}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/><TextBlock Text="진행 중" Style="{StaticResource SmallText}"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="{Binding BlockedCount}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Warning}"/><TextBlock Text="보류" Style="{StaticResource SmallText}"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="{Binding DoneTodayCount}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Success}"/><TextBlock Text="오늘 완료" Style="{StaticResource SmallText}"/></StackPanel></Grid></Border>
    <ListBox x:Name="MessageList" Grid.Row="2" ItemsSource="{Binding Messages}" Background="Transparent" BorderThickness="0" Padding="0,4" ScrollViewer.CanContentScroll="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" PreviewMouseWheel="OnMessageListMouseWheel">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Focusable" Value="False"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,18"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><StaticResource ResourceKey="MessageBubbleTemplate"/></ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10"><Button Content="＋ 업무 추가" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/><Button Content="오늘" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/><Button Content="✓ 완료" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/><Button Content="기록" Style="{StaticResource SecondaryButton}"/></StackPanel>
    <Border Grid.Row="4" Background="{StaticResource BackgroundSecondary}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="15" Padding="9" Margin="{StaticResource ApplicationContentMargin}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="＋" Style="{StaticResource IconButton}" ToolTip="Attach or add" VerticalAlignment="Bottom"/><TextBox Grid.Column="1" Text="{Binding DraftMessage, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}" CaretBrush="{StaticResource TextPrimary}" FontSize="14" VerticalContentAlignment="Center" Padding="10,7" MaxLength="2000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="42" MaxHeight="140" VerticalScrollBarVisibility="Auto"><TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SendCommand}"/></TextBox.InputBindings></TextBox><TextBlock Grid.Column="1" Text="업무 내용을 입력하세요..." Foreground="{StaticResource TextSecondary}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="10,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DraftMessage}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding DraftMessage}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Button Grid.Column="2" Content="↑" Style="{StaticResource SendButton}" Command="{Binding SendCommand}" ToolTip="Send message" VerticalAlignment="Bottom"/></Grid></Border>
  </Grid>
</UserControl>
