<UserControl x:Class="SlaveSplit.Views.TasksView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource BackgroundPrimary}">
  <Grid MaxWidth="{StaticResource ApplicationContentMaxWidth}" HorizontalAlignment="Stretch"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="{StaticResource ApplicationHeaderMargin}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Tasks" Style="{StaticResource PageTitle}"/><TextBlock Text="All work, ordered around what changed recently." Style="{StaticResource SecondaryText}" Margin="0,5,0,0"/></StackPanel><TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Background="{StaticResource BackgroundSecondary}" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource Border}" Padding="10,8" VerticalAlignment="Center" ToolTip="Search tasks..."><TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchCommand}"/></TextBox.InputBindings></TextBox><ComboBox Grid.Column="2" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}" Margin="8,0,0,0" Padding="8" VerticalAlignment="Center"/></Grid>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="{StaticResource ApplicationToolbarMargin}"><Button Content="All" Style="{StaticResource SecondaryButton}" Command="{Binding FilterCommand}" CommandParameter="All" Margin="0,0,7,0"/><Button Content="Todo" Style="{StaticResource SecondaryButton}" Command="{Binding FilterCommand}" CommandParameter="Todo" Margin="0,0,7,0"/><Button Content="In Progress" Style="{StaticResource SecondaryButton}" Command="{Binding FilterCommand}" CommandParameter="In Progress" Margin="0,0,7,0"/><Button Content="Blocked" Style="{StaticResource SecondaryButton}" Command="{Binding FilterCommand}" CommandParameter="Blocked" Margin="0,0,7,0"/><Button Content="Done" Style="{StaticResource SecondaryButton}" Command="{Binding FilterCommand}" CommandParameter="Done"/></StackPanel>
    <Grid Grid.Row="2"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Tasks}" Margin="{StaticResource ApplicationContentMargin}"><ItemsControl.ItemTemplate><DataTemplate><Button Command="{Binding DataContext.OpenTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Cursor="Hand"><Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Card" Style="{StaticResource CardStyle}" Margin="0,0,14,11" Padding="18,15"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding Metadata}" Style="{StaticResource SmallText}" Margin="0,6,0,0"/><TextBlock Text="{Binding BlockedReason}" Foreground="{StaticResource Warning}" FontSize="12" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right"><Border Style="{StaticResource StatusBadge}"><TextBlock Text="{Binding StatusText}" Foreground="#B9B1FF" FontWeight="Bold" FontSize="10"/></Border><TextBlock Text="{Binding DueLabel}" HorizontalAlignment="Right" Margin="0,8,0,0" FontSize="11"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextSecondary}"/><Style.Triggers><DataTrigger Binding="{Binding IsOverdue}" Value="True"><Setter Property="Foreground" Value="{StaticResource Error}"/><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Card" Property="Opacity" Value=".75"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsEmpty}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="아직 등록된 업무가 없습니다." Style="{StaticResource PageTitle}"/><TextBlock Text="Chat에서 해야 할 일을 말해보세요." Style="{StaticResource SecondaryText}" HorizontalAlignment="Center" Margin="0,8,0,0"/><TextBlock Text="오늘 A2 로그 분석해야 해" Style="{StaticResource SmallText}" HorizontalAlignment="Center" Margin="0,6,0,0"/></StackPanel></Grid>
  </Grid>
</UserControl>
