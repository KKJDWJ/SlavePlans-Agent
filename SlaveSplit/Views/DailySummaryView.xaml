<UserControl x:Class="SlaveSplit.Views.DailySummaryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource BackgroundPrimary}">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid MaxWidth="{StaticResource ApplicationContentMaxWidth}" Margin="{StaticResource ApplicationPageMargin}" HorizontalAlignment="Stretch"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="TODAY SUMMARY" Style="{StaticResource PageTitle}"/><TextBlock Text="{Binding DateText}" Style="{StaticResource SecondaryText}" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock Text="{Binding CopyStatus}" Style="{StaticResource SmallText}" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Content="Copy summary" Style="{StaticResource PrimaryButton}" Command="{Binding CopyCommand}"/></StackPanel></Grid>
    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,22,0,18"><UniformGrid Columns="4"><StackPanel><TextBlock Text="{Binding Summary.CompletedCount}" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource Success}"/><TextBlock Text="COMPLETED" Style="{StaticResource SmallText}"/></StackPanel><StackPanel><TextBlock Text="{Binding Summary.InProgress.Count}" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/><TextBlock Text="IN PROGRESS" Style="{StaticResource SmallText}"/></StackPanel><StackPanel><TextBlock Text="{Binding Summary.CarryOver.Count}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="CARRY OVER" Style="{StaticResource SmallText}"/></StackPanel><StackPanel><TextBlock Text="{Binding Summary.BlockedCount}" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource Warning}"/><TextBlock Text="BLOCKED" Style="{StaticResource SmallText}"/></StackPanel></UniformGrid></Border>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource CardStyle}" Margin="0,0,9,18"><StackPanel><TextBlock Text="COMPLETED TODAY" Style="{StaticResource SectionTitle}" Foreground="{StaticResource Success}"/><ItemsControl ItemsSource="{Binding Completed}" Margin="0,12,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="✓" Foreground="{StaticResource Success}"/><TextBlock Grid.Column="1" Text="{Binding Title}" TextWrapping="Wrap"/><TextBlock Grid.Column="2" Text="{Binding CompletedAt, StringFormat=HH:mm}" Style="{StaticResource SmallText}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border><StackPanel Grid.Column="1"><Border Style="{StaticResource CardStyle}" Margin="9,0,0,12"><StackPanel><TextBlock Text="REMAINING" Style="{StaticResource SectionTitle}"/><ItemsControl ItemsSource="{Binding Remaining}" Margin="0,12,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title, StringFormat=→ {0}}" Margin="0,6" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border><Border Style="{StaticResource CardStyle}" Margin="9,0,0,18"><StackPanel><TextBlock Text="BLOCKED" Style="{StaticResource SectionTitle}" Foreground="{StaticResource Warning}"/><ItemsControl ItemsSource="{Binding Blocked}" Margin="0,12,0,0"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,5"><TextBlock Text="{Binding Title, StringFormat=⚠ {0}}"/><TextBlock Text="{Binding BlockedReason}" Style="{StaticResource SmallText}" Margin="16,3,0,0"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></StackPanel></Grid>
    <Border Grid.Row="3" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="WORK LOG" Style="{StaticResource SectionTitle}"/><TextBox Text="{Binding SummaryText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Background="Transparent" Foreground="{StaticResource TextSecondary}" BorderThickness="0" Margin="0,12,0,0" MinHeight="180"/></StackPanel></Border>
  </Grid></ScrollViewer>
</UserControl>
