<UserControl x:Class="SlaveSplit.Views.LocalLlmPocView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource BackgroundPrimary}" Foreground="{StaticResource TextPrimary}">
  <UserControl.Resources>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
      <Setter Property="Background" Value="#0D121B"/>
      <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}"/>
      <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
      <Setter Property="Padding" Value="10"/>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}"/>
    <Style TargetType="DataGrid"><Setter Property="Background" Value="#0D121B"/><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="GridLinesVisibility" Value="All"/><Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Border}"/><Setter Property="VerticalGridLinesBrush" Value="{StaticResource Border}"/><Setter Property="RowBackground" Value="#0D121B"/><Setter Property="AlternatingRowBackground" Value="#121925"/><Setter Property="HeadersVisibility" Value="Column"/></Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#181E2A"/><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="Padding" Value="8,6"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="DataGridCell"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="Padding" Value="7,4"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="TextBlock.TextAlignment" Value="Center"/></Style>
    <Style TargetType="DataGridRow"><Setter Property="Background" Value="#0D121B"/><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="MinHeight" Value="30"/><Setter Property="VerticalContentAlignment" Value="Center"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#2A3150"/></Trigger></Style.Triggers></Style>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource BackgroundPrimary}">
    <Grid Margin="{StaticResource ApplicationPageMargin}" MaxWidth="{StaticResource ApplicationContentMaxWidth}" HorizontalAlignment="Stretch"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel><TextBlock Text="Hybrid Command Interpreter" Style="{StaticResource PageTitle}"/><TextBlock Text="Current Parser + Qwen Local LLM Fallback · 어떤 결과도 Task/GitHub에 실행되지 않습니다." Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/></StackPanel>
      <Border Grid.Row="1" Background="{StaticResource BackgroundSecondary}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,18,0,0"><StackPanel>
        <StackPanel Orientation="Horizontal"><Button Content="Ollama 연결 / 모델 탐색" Command="{Binding ConnectCommand}" Padding="14,7"/><TextBlock Text="{Binding LocalAiStatus, StringFormat=Local AI: {0}}" Margin="14,8,0,0"/><TextBlock Text="{Binding SelectedModel, StringFormat=Model: {0}}" Margin="14,8,0,0"/><TextBlock Text="{Binding LocalAiEndpoint, StringFormat=Endpoint: {0}}" Margin="14,8,0,0"/><TextBlock Text="{Binding LocalAiLastError, StringFormat=Last Error: {0}}" Margin="14,8,0,0"/></StackPanel>
        <TextBlock Text="INPUT" FontWeight="Bold" Margin="0,16,0,5"/><TextBox Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" Padding="10"/>
        <TextBlock Text="CURRENT TASKS / CANDIDATE CONTEXT" FontWeight="Bold" Margin="0,14,0,5"/><TextBox Text="{Binding Context, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="90" VerticalScrollBarVisibility="Auto" Padding="10"/>
        <StackPanel Orientation="Horizontal" Margin="0,14,0,0"><Button Content="현재 입력 비교" Command="{Binding RunCommand}" Style="{StaticResource PrimaryButton}" Padding="18,8"/><Button Content="필수 문장 전체 실행" Command="{Binding RunSuiteCommand}" Padding="18,8" Margin="10,0,0,0"/></StackPanel>
      </StackPanel></Border>
      <Grid Grid.Row="2" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Background="{StaticResource BackgroundSecondary}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,8,0"><StackPanel><TextBlock Text="Current Parser Result (read-only probe)" FontWeight="Bold"/><TextBox Text="{Binding CurrentResult}" IsReadOnly="True" TextWrapping="Wrap" Margin="0,10,0,0" MinHeight="100"/></StackPanel></Border>
        <Border Grid.Column="1" Background="{StaticResource BackgroundSecondary}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="8,0,0,0"><StackPanel><TextBlock Text="Qwen Result" FontWeight="Bold"/><TextBox Text="{Binding GraniteResult}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,10,0,0" MinHeight="100" VerticalScrollBarVisibility="Auto"/></StackPanel></Border>
      </Grid>
      <Border Grid.Row="3" Background="{StaticResource BackgroundSecondary}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,16,0,0"><StackPanel><TextBlock Text="Hybrid Final Result" FontWeight="Bold"/><TextBlock Text="{Binding HybridResult}" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock Text="{Binding DecisionReason}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,5,0,0"/><TextBlock Text="Metrics" FontWeight="Bold" Margin="0,12,0,0"/><TextBlock Text="{Binding Metrics}" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
      <Border Grid.Row="4" Background="{StaticResource BackgroundSecondary}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,16,0,0"><StackPanel><TextBlock Text="Per-test benchmark details" FontWeight="Bold" Margin="6,3,0,10"/><DataGrid ItemsSource="{Binding Results}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" Height="390" FrozenColumnCount="2">
        <DataGrid.Columns>
          <DataGridTextColumn Header="No" Binding="{Binding No}" Width="42"/><DataGridTextColumn Header="Input" Binding="{Binding Input}" Width="230"/><DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="160"/><DataGridTextColumn Header="Expected" Binding="{Binding Expected}" Width="190"/><DataGridTextColumn Header="Parser Result" Binding="{Binding ParserResult}" Width="190"/><DataGridTextColumn Header="LLM Result" Binding="{Binding LlmResult}" Width="190"/>
          <DataGridTextColumn Header="Hybrid Result" Binding="{Binding HybridResult}" Width="190"/><DataGridTextColumn Header="Hybrid Source" Binding="{Binding HybridSource}" Width="105"/><DataGridTextColumn Header="Decision Reason" Binding="{Binding DecisionReason}" Width="330"/><DataGridTextColumn Header="Fallback" Binding="{Binding FallbackCalled}" Width="80"/><DataGridTextColumn Header="Hybrid PASS/FAIL" Binding="{Binding HybridPass}" Width="115"/>
          <DataGridTextColumn Header="Expected Intent" Binding="{Binding ExpectedIntent}" Width="115"/><DataGridTextColumn Header="Expected Targets" Binding="{Binding ExpectedTargets}" Width="105"/><DataGridTextColumn Header="Expected Status" Binding="{Binding ExpectedStatus}" Width="100"/>
          <DataGridTextColumn Header="Current Intent" Binding="{Binding CurrentIntent}" Width="110"/><DataGridTextColumn Header="Current Targets" Binding="{Binding CurrentTargets}" Width="100"/><DataGridTextColumn Header="Current Status" Binding="{Binding CurrentStatus}" Width="95"/><DataGridTextColumn Header="Current PASS/FAIL" Binding="{Binding CurrentPass}" Width="120"/>
          <DataGridTextColumn Header="Granite Raw Response" Binding="{Binding GraniteRaw}" Width="330"/><DataGridTextColumn Header="Granite Intent" Binding="{Binding GraniteIntent}" Width="110"/><DataGridTextColumn Header="Granite Targets" Binding="{Binding GraniteTargets}" Width="105"/><DataGridTextColumn Header="Granite Status" Binding="{Binding GraniteStatus}" Width="100"/>
          <DataGridTextColumn Header="JSON" Binding="{Binding JsonPass}" Width="75"/><DataGridTextColumn Header="Schema" Binding="{Binding SchemaPass}" Width="75"/><DataGridTextColumn Header="Semantic" Binding="{Binding SemanticPass}" Width="85"/><DataGridTextColumn Header="Evaluation" Binding="{Binding EvaluationPass}" Width="85"/><DataGridTextColumn Header="Final" Binding="{Binding FinalPass}" Width="180"/><DataGridTextColumn Header="Cold/Warm" Binding="{Binding ColdStart}" Width="85"/><DataGridTextColumn Header="LatencyMs" Binding="{Binding LatencyMs}" Width="85"/><DataGridTextColumn Header="Failure Classification" Binding="{Binding Failure}" Width="260"/>
        </DataGrid.Columns>
      </DataGrid></StackPanel></Border>
      <Border Grid.Row="5" Background="{StaticResource BackgroundSecondary}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,16,0,20"><TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontFamily="Consolas"/></Border>
      <Border Grid.Row="6" Background="{StaticResource BackgroundSecondary}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,20"><TextBlock Text="{Binding HybridSummary}" TextWrapping="Wrap" FontFamily="Consolas"/></Border>
    </Grid>
  </ScrollViewer>
</UserControl>
